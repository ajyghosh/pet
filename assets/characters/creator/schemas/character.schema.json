{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MiniMates custom character manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "style",
    "source",
    "appearance",
    "animations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^custom-[a-zA-Z0-9_-]{1,57}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "style": {
      "enum": ["cute-3d"]
    },
    "source": {
      "enum": ["manual"]
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "skinTone", "hairStyle", "hairColor", "outfit"],
      "properties": {
        "base": {
          "enum": ["adult-neutral-01", "adult-slim-01", "adult-rounded-01"]
        },
        "skinTone": {
          "enum": ["fair", "light", "medium", "tan", "brown", "deep"]
        },
        "hairStyle": {
          "enum": ["short-wavy", "side-part", "bob", "long", "bun", "bald"]
        },
        "hairColor": {
          "enum": ["black", "dark-brown", "brown", "blonde", "silver", "rose"]
        },
        "outfit": {
          "enum": [
            "blue-shirt-jeans",
            "jacket",
            "hoodie",
            "dress",
            "saree",
            "kurta",
            "mundu"
          ]
        },
        "shoes": {
          "enum": ["white-sneakers", "dark-boots", "coral-trainers"]
        },
        "accessories": {
          "type": "array",
          "items": {
            "enum": ["glasses", "hat", "headphones", "bag"]
          },
          "uniqueItems": true,
          "maxItems": 4
        },
        "faceShape": {
          "enum": ["round", "oval", "soft-square"]
        },
        "eyeStyle": {
          "enum": ["round", "almond"]
        },
        "browStyle": {
          "enum": ["soft", "straight"]
        },
        "facialHair": {
          "enum": ["none", "moustache", "beard"]
        },
        "outfitColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "animations": {
      "type": "object",
      "maxProperties": 0,
      "description": "Phase 1 uses the bundled procedural rig; external animation paths are unsupported."
    },
    "personality": {
      "type": "string",
      "maxLength": 100
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  }
}
